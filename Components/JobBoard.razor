@* 

    Logo -> Link with Company Website 
        - Company Website
    Company Name
    Role - Postion

    Location
    Reference Link (Where Applied)

    Applied Date - Time
    Last Update Date - Time

    Action
    - Status 
    - Next Action - Pending 

    Utils
    - Archive (Soft Delete)
    - Edit


*@


<div class="container border border-1 border-black rounded-5 mb-3 p-2 justify-content-between">
    <div class="row justify-content-between">
        <div class="logo d-flex col-2 justify-content-center align-items-center text-center">
            <a href="@Job.Link" target="_blank" rel="noopener">
                <img class="logo-img" src="@Job.LogoImgLink" alt="" />
            </a>
        </div>
        <div class="details-container col-4 d-flex justify-content-between m-0 p-0">

            <div class="details m-0 p-0">
                <div class="d-flex align-items-center justify-content-start gap-3">
                    <p class="label fs-2 fw-bold text-black">@Job.CompanyName</p>
                    <p class="label fs-5 fw-light text-black mb-1">@Job.Position / @Job.Role</p>
                </div>

                <p class="label fw-light text-black"><span class="fw-bold">Location: </span>@Job.Location</p>
                <p class="label fw-light text-black"><span class="fw-bold">Contact: </span>@Job.Name -
                    @Job.Email - @Job.Number</p>


                <p>Time Applied: @Job.DateApplied </p>
                <p>Lasest Update: @Job.DateUpdate </p>


            </div>
        </div>
        <div class="container col-5 action-status-section align-items-center justify-content-center my-auto">
            <div class="d-flex row justify-content-center mb-2">
                <div class="col-3">
                    <div class="label fw-bold text-dark">Status:</div>

                </div>
                <div class="col-3">
                    <div class="dropdown">
                        <button
                            class="dropButton btn status-btn @GetStatusClass(Job.CurrentStatus) dropdown-toggle opacity-75"
                            type="button" data-bs-toggle="dropdown">
                            @Job.CurrentStatus
                        </button>

                        <ul class="dropdown-menu">
                            @foreach (var status in Enum.GetValues<StatusList>())
                            {
                                <li>
                                    <a class="dropdown-item" @onclick="() => OnStatusPick(status.ToString())">
                                        @status
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
            <div class="d-flex row justify-content-center ">
                <div class="col-3">

                    <div class="label fw-bold text-dark">Next Action:</div>


                </div>
                <div class="col-3">
                    <div class="d-flex gap-2 text-center align-items-center">

                        <div class="dropdown">
                            <button
                                class="dropButton btn nextAction-btn @GetNextActionClass(Job.NextAction) dropdown-toggle opacity-75"
                                type="button" data-bs-toggle="dropdown">
                                @Job.NextAction
                            </button>

                            <ul class="dropdown-menu">
                                @foreach (var nextAction in Enum.GetValues<NextActionList>())
                                {
                                    <li>
                                        <a class="dropdown-item" @onclick="() => OnNextActionPick(nextAction.ToString())">
                                            @nextAction
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <div class="d-flex flex-column utils col-1 justify-content-center align-items-center">
            <button class="btn my-auto" @onclick="() => EditJob(Job.Id)">
                <i class="fa-solid fa-pen-to-square"></i>
            </button>
            <button class=" btn my-auto disabled">
                <i class="fa-solid fa-box-archive "></i>
            </button>
            <button class="btn my-auto" @onclick = "@DeleteApplication">
                <i class="fa-solid fa-trash-can"></i>
            </button>
        </div>
    </div>
</div>



@code {
    [Parameter, EditorRequired]
    public JobApplication Job { get; set; } = default!;


    // Status Change
    [Parameter]
    public EventCallback<JobApplication> OnStatusChanged { get; set; }

    private async Task OnStatusPick(string newStatus)
    {
        if (Enum.TryParse<StatusList>(newStatus, out var status))
        {
            Job.CurrentStatus = status;
            await OnStatusChanged.InvokeAsync(Job);
        }
    }

    private string GetStatusClass(StatusList status) => status switch
    {
        StatusList.NoHope => "bg-black text-white",
        StatusList.Submitted => "bg-primary text-white fw-bold",
        StatusList.Interviewed => "bg-info text-white fs-bold",
        StatusList.Accepted => "bg-success text-white fw-bold",
        StatusList.Rejected => "bg-danger text-white fw-bold",
        StatusList.Offer => "bg-warning text-black fw-bold",
        _ => ""
    };

    // Next Action Change

    [Parameter]
    public EventCallback<JobApplication> OnNextActionChanged { get; set; }


    private async Task OnNextActionPick(string newNextAction)
    {
        if (Enum.TryParse<NextActionList>(newNextAction, out var action))
        {
            Job.NextAction = action;
            await OnNextActionChanged.InvokeAsync(Job);
        }
    }

    private string GetNextActionClass(NextActionList nextAction) => nextAction switch
    {
        NextActionList.NoHope => "bg-black text-white",
        NextActionList.Pending => "bg-secondary text-black fw-bold",
        NextActionList.FollowUp => "bg-info text-dark fw-bold",
        NextActionList.Waiting => "bg-secondary text-white fw-bold",
        NextActionList.PrepInterview => "bg-warning text-black fw-bold",
        NextActionList.SendEmail => "bg-info text-black fw-bold",
        NextActionList.Decide => "bg-success text-white fw-bold",
        _ => ""
    };


    // Delete
    [Parameter]
    public EventCallback<Guid> OnDelete { get; set; }
    private async Task DeleteApplication()
    {
        await OnDelete.InvokeAsync(Job.Id);
    }


    // edit
    public void EditJob(Guid id)
    {
        Navigation.NavigateTo($"/edit-job/{id}");
    }
}